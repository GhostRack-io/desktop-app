{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gigahost",
  "version": "0.1.2",
  "identifier": "cloud.gigahost.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Gigahost",
        "width": 1440,
        "height": 1000,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Finance",
    "shortDescription": "Your Gigahost account and MMX wallet",
    "longDescription": "Create and manage Gigahost account keys, log in, authorize hosted restores, top up service credit, and send or receive MMX.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/gigahost-ghost",
      "binaries/gigahost-mmxwallet"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "xdg-utils",
          "desktop-file-utils"
        ],
        "desktopTemplate": "gigahost.desktop.hbs",
        "files": {
          "/usr/share/applications/cloud.gigahost.desktop.desktop": "cloud.gigahost.desktop.desktop"
        }
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/share/applications/cloud.gigahost.desktop.desktop": "cloud.gigahost.desktop.desktop"
        }
      }
    },
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../public/shared/instrument-sans-ofl.txt": "licenses/instrument-sans-ofl.txt",
      "../public/shared/geist-mono-ofl.txt": "licenses/geist-mono-ofl.txt"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "gigahost"
        ]
      }
    }
  }
}
